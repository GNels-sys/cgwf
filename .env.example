# Copy to .env for local development. Never commit .env.
# Where SQLite, downloaded bulk data and cached images live. On Fly this is the volume.
DATA_DIR=./data
# Port the server listens on.
PORT=8080
# Shown to Scryfall in the User-Agent header so they can contact us if needed.
CONTACT_EMAIL=you@example.com
# How often (hours) card data is considered stale and re-downloaded.
CARD_DATA_MAX_AGE_HOURS=24
# Set to "1" to skip the automatic Scryfall download on boot (handy for local work).
SKIP_AUTO_INGEST=0
# Optional: the one-time code that grants the owner flag from the profile page. Unset = disabled.
OWNER_CLAIM_CODE=
# Phase 7 computer opponents (owner only). AGENTS_ENABLED=1 turns the feature on; without an
# ANTHROPIC_API_KEY agents run in dry-run mode (scripted, no model calls). Caps are USD.
AGENTS_ENABLED=0
ANTHROPIC_API_KEY=
# Only for organisation-level keys that are not scoped to a workspace (wrkspc_... from the Console).
ANTHROPIC_WORKSPACE_ID=
AGENT_MODEL=claude-sonnet-5-5
AGENT_MAX_USD_PER_GAME=6
AGENT_MAX_USD_PER_DAY=25
# Phase 10 local-stores bridge: the Singles site (vegas-mtg) service API. Both unset = feature off
# (routes answer status "unconfigured"). The token is the same value as SERVICE_API_TOKEN on that app.
SINGLES_API_URL=
SINGLES_API_TOKEN=
SINGLES_TIMEOUT_MS=4000
